# ===== TELEGRAM =====
# Tạo bot qua @BotFather -> lấy token
TELEGRAM_BOT_TOKEN=
# Chat ID cá nhân hoặc nhóm (lấy qua @userinfobot hoặc lệnh: python -m pi_alert.main --get-chat-id)
TELEGRAM_CHAT_ID=

# ===== NGUỒN DỮ LIỆU =====
# okx | bitget | mexc | gate  (lỗi sẽ tự chuyển sang sàn kế tiếp)
EXCHANGE=okx
# swap = hợp đồng vĩnh cửu PIUSDT Perpetual, spot = giao ngay
MARKET=swap

# ===== CHU KỲ =====
CHECK_INTERVAL=60          # giây giữa 2 lần quét
SIGNAL_TF=15m              # khung tín hiệu UT Bot / Step Channel / RSI
TREND_TF=4h                # khung xu hướng lớn
SUMMARY_HOURS=4            # gửi báo cáo tổng hợp mỗi N giờ (0 = tắt)

# ===== NGƯỠNG BIẾN ĐỘNG (%) =====
MOVE_15M_PCT=3
MOVE_1H_PCT=5
MOVE_24H_PCT=10
MOVE_COOLDOWN_MIN=30

# Các mốc giá cần báo khi giá cắt qua (phân tách bằng dấu phẩy)
PRICE_LEVELS=0.11,0.12

# ===== CHỈ BÁO =====
UT_KEY=2                   # UT Bot "Key Value" (độ nhạy)
UT_ATR=1                   # UT Bot "ATR Period"
SCMT_LEN=3                 # Step Channel: độ dài pivot
SCMT_MULT=0.6              # Step Channel: hệ số độ rộng kênh (x ATR)
RSI_LOW=30
RSI_HIGH=70
VOL_SPIKE=3                # khối lượng nến > 3 lần trung bình 20 nến
FUNDING_ALERT_PCT=0.1      # |funding| >= 0.1%/8h thì cảnh báo

# 1 = chỉ in ra màn hình, không gửi Telegram
DRY_RUN=0
